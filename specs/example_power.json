    {
      "id": "SEL-003",
      "module_name": "信号调理运算放大器",
      "module_type": "信号链",
      "category": "operational_amplifier",
      "leaf_code": "l_amplifier",
      "level2": "operational_amplifier",
      "quantity": 2,
      "related_requirements": ["F04"],
      "keywords": ["LM358", "MCP602"],
      "preferred_conditions": [
        {
          "field": "package",
          "op": "not_contains",
          "value": "BGA",
          "reason": "手工焊接优先，避免 BGA",
