    {
      "id": "M-PWR-STBY-001",
      "module_name": "待机LDO稳压器",
      "module_type": "电源管理",
      "category": "电源管理 IC",
      "leaf_code": "l_professional_power_management_pmic",
      "quantity": 1,
      "related_requirements": [],
      "hard_conditions": [
        {
          "field": "input_voltage_range",
          "op": "cover",
          "value": [
            4.5,
            5.5
          ],
          "unit": "V",
          "reason": "LDO直接连接主板待机5V轨(ATX 24Pin的+5VSB)。输入电压必须覆盖ATX标准下的+5VSB波动范围（通常±5%或更宽，考虑到PSU质量及长线缆压降），否则无法正常工作。",
          "source_parameter": "input_voltage_range"
        },
        {
          "field": "dropout_voltage",
          "op": "<=",
          "value": 0.5,
          "unit": "V",
          "reason": "作为线性稳压器，压差(Vin-Vout)决定了功耗和热设计。在5V转3.3V时，压差约1.7V；在5V转1.05V时，压差约3.95V。LDO必须在整个工作电流范围内保持在此压差下稳压。低压差特性有助于降低功耗，特别是在大压差情况下（如5V->1.05V）。",
          "source_parameter": "dropout_voltage"
        },
        {
          "field": "quiescent_current",
          "op": "<=",
          "value": 0.0001,
          "unit": "A",
          "reason": "ErP Lot 6标准要求系统待机功耗极低（通常整机<1W或更低，取决于配置）。LDO的静态电流(Iq)直接贡献于待机功耗。因此，必须选用超低静态电流(Low Iq)的LDO器件，以确保在不带载或轻载时功耗最小化。",
          "source_parameter": "quiescent_current"
        },
        {
          "field": "operating_temperature",
          "op": "cover",
          "value": [
            -40.0,
            85.0
          ],
          "unit": "°C",
          "reason": "尽管机箱内环境温度可能在0-60°C，但关键电源器件建议采用工业级以保证长期可靠性及应对局部热点。器件本身的工作温度范围需覆盖此区间并留有裕量。",
          "source_parameter": "operating_temperature_range"
        }
      ],
      "preferred_conditions": [
        {
          "field": "output_current",
          "op": ">=",
          "value": 0.5,
          "unit": "A",
          "reason": "虽然待机总电流很小(<1W)，但需考虑PCH待机域突发活动、RTC备份电路及可能的USB唤醒电流。LDO需能稳定提供所需峰值电流而不发生过热或电压跌落。RT9193通常为1A或3A级，对于待机应用绰绰有余，但过大的电流额定值可能带来不必要的成本或尺寸。",
          "source_parameter": "max_output_current"
        },
        {
          "field": "package",
          "op": "is",
          "value": "['SOT-23-5', 'DFN-6']",
          "reason": "主板空间有限，且该LDO位于待机区域，靠近PCH。小型封装有利于PCB布局紧凑。常见的LDO如SOT-23-5, DFN-6等适合此类应用。",
          "source_parameter": "package_type"
        }
      ],
      "keywords": [
        "LDO",
        "Low Dropout Regulator",
        "低压差线性稳压器",
        "线性稳压IC",
        "5V转3.3V",
        "待机电源"
      ]
    },
