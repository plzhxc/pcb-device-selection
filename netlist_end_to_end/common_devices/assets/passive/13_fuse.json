{
  "schema_version": "1.0",
  "template_id": "common.passive.fuse",
  "version": "1.0.0",
  "status": "implemented",
  "family": "passive",
  "kind": "primitive",
  "description": "表达熔断式保险丝的两个端子和额定信息。连接例子仅示意一个串联支路，不保证对某负载的保护效果。",
  "parameters_schema": {
    "type": "object",
    "properties": {
      "technology": {
        "const": "fusible",
        "description": "首版仅熔断式保险丝；不包含PPTC自恢复件。"
      },
      "rated_current_a": {
        "type": "number",
        "description": "额定电流，A；不等于瞬时动作电流。",
        "exclusiveMinimum": 0
      },
      "rated_voltage_v": {
        "type": "number",
        "description": "对应电压类别的额定电压，V。",
        "exclusiveMinimum": 0
      },
      "voltage_kind": {
        "type": "string",
        "enum": [
          "dc",
          "ac_rms"
        ],
        "description": "额定电压类别；DC与AC RMS不能互相替代。"
      },
      "breaking_capacity_a": {
        "type": [
          "number",
          "null"
        ],
        "description": "相应条件下的分断能力，A；未知为null。",
        "exclusiveMinimum": 0
      },
      "time_current_curve_ref": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "description": "时间-电流曲线依据；未知为null。"
      }
    },
    "required": [
      "technology",
      "rated_current_a",
      "rated_voltage_v",
      "voltage_kind",
      "breaking_capacity_a",
      "time_current_curve_ref"
    ],
    "additionalProperties": false
  },
  "ports": [
    {
      "id": "a",
      "direction": "passive",
      "domain": "electrical",
      "width": 1
    },
    {
      "id": "b",
      "direction": "passive",
      "domain": "electrical",
      "width": 1
    }
  ],
  "body": {
    "representation": "terminal_contract",
    "description": "保留两个独立端点及器件实例；由显式pin_bindings建立角色和引脚的对应，不推断商品脚序或自动合并网络。"
  },
  "rules": [
    {
      "id": "keep_series_device",
      "severity": "error",
      "description": "输入端和输出端分别绑定网络，器件实例不能被当作导线删除。"
    },
    {
      "id": "rating_kind",
      "severity": "error",
      "description": "电压比较须使用明确的AC/DC类别，不能把额定电压当实际供电网络的电压。"
    },
    {
      "id": "protection_evidence",
      "severity": "unresolved",
      "description": "缺少时间-电流曲线或分断能力时，不得宣布短路保护或选择配合通过。"
    }
  ],
  "sources": [
    {
      "kind": "design_contract",
      "reference": "00_Project-SPEC/netlist_design/NETLIST_GENERATION_DESIGN.md"
    }
  ],
  "example": {
    "parameters": {
      "technology": "fusible",
      "rated_current_a": 1,
      "rated_voltage_v": 32,
      "voltage_kind": "dc",
      "breaking_capacity_a": null,
      "time_current_curve_ref": null
    },
    "pin_space": "logical",
    "pin_bindings": [
      {
        "port": "a",
        "bit": 0,
        "pin_id": "a"
      },
      {
        "port": "b",
        "bit": 0,
        "pin_id": "b"
      }
    ],
    "pins": [
      {
        "id": "a",
        "name": "a",
        "net": "N_INPUT"
      },
      {
        "id": "b",
        "name": "b",
        "net": "N_OUTPUT"
      }
    ],
    "expected": {
      "status": "logical_ready",
      "notes": "人工逻辑示例，仅连接信息就绪；可空性能参数仍为未知，未确认物理脚号或电气验证。"
    }
  },
  "device_type": "fuse",
  "designator_prefix": "F",
  "abstract_description": "保险丝",
  "value_spec": {
    "parameter": "rated_current_a",
    "unit": "A"
  }
}
