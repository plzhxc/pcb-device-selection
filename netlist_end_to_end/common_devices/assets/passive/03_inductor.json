{
  "schema_version": "1.0",
  "template_id": "common.passive.inductor",
  "version": "1.0.0",
  "status": "implemented",
  "family": "passive",
  "kind": "primitive",
  "description": "单个二端、非耦合电感的逻辑端子契约，不把多绕组磁性器件简化成二端器件。",
  "parameters_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "inductance_h": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "标称电感量，SI 单位 H，必填且不可 null，严格大于 0。"
      },
      "dc_resistance_ohm": {
        "type": [
          "number",
          "null"
        ],
        "description": "直流电阻，SI 单位 Ω；已知时大于或等于 0，可省略或 null，不自动填 0。",
        "minimum": 0
      },
      "rated_current_a": {
        "type": [
          "number",
          "null"
        ],
        "description": "输入资料给出的额定电流，SI 单位 A；已知时严格大于 0，可省略或 null。其测试定义需另附来源，不等同于自动通过饱和或温升校核。",
        "exclusiveMinimum": 0
      }
    },
    "required": [
      "inductance_h"
    ],
    "additionalProperties": false
  },
  "ports": [
    {
      "id": "a",
      "direction": "passive",
      "domain": "electrical",
      "width": 1
    },
    {
      "id": "b",
      "direction": "passive",
      "domain": "electrical",
      "width": 1
    }
  ],
  "body": {
    "representation": "terminal_contract",
    "description": "一个二端独立电感连接 a 与 b；仅声明端子和参数，不进行直流短接化简、磁耦合推断或动态仿真。"
  },
  "rules": [
    {
      "id": "explicit_endpoint_binding",
      "severity": "error",
      "description": "每个逻辑端口的每一位必须恰好绑定一个示例引脚，每个引脚恰好被覆盖一次；端口名、引脚名、列表顺序均不替代显式绑定。"
    },
    {
      "id": "net_identity",
      "severity": "error",
      "description": "同一实例作用域中只有相同的非空网名表示相同网络；null 表示已知未连接，不与其他 null 自动互连。"
    },
    {
      "id": "physical_binding_missing",
      "severity": "unresolved",
      "description": "logical 示例仅证明逻辑连接已声明。需要物理导出时，必须提供全部实际引脚及来源，不得把 a、b 等逻辑 ID 当作真实脚号。"
    },
    {
      "id": "not_a_wire",
      "severity": "error",
      "description": "不能依据电感在某工作条件下的近似行为删除电感、合并两端网名或把电感量未知改成 0。"
    },
    {
      "id": "winding_boundary",
      "severity": "error",
      "description": "只有一个二端独立绕组适用此模板；检测到更多绕组或实际引脚时保留完整源记录并要求其他契约。"
    },
    {
      "id": "current_check_scope",
      "severity": "unresolved",
      "description": "要求电流、饱和或温升校核时，缺少相应额定定义、波形或条件即标记未决；单独 rated_current_a 不证明所有校核通过。"
    }
  ],
  "sources": [
    {
      "kind": "design_contract",
      "reference": "00_Project-SPEC/netlist_design/NETLIST_GENERATION_DESIGN.md"
    }
  ],
  "example": {
    "parameters": {
      "inductance_h": 1e-05,
      "dc_resistance_ohm": null,
      "rated_current_a": null
    },
    "pin_space": "logical",
    "pin_bindings": [
      {
        "port": "a",
        "bit": 0,
        "pin_id": "a"
      },
      {
        "port": "b",
        "bit": 0,
        "pin_id": "b"
      }
    ],
    "pins": [
      {
        "id": "a",
        "name": "a",
        "net": "INPUT_BRANCH"
      },
      {
        "id": "b",
        "name": "b",
        "net": "OUTPUT_BRANCH"
      }
    ],
    "expected": {
      "status": "logical_ready",
      "notes": "人为示例为 10 µH 两端连接，不表示建议用于任何具体电源或滤波电路；未校核电流、损耗及磁性工作条件。"
    }
  },
  "device_type": "inductor",
  "designator_prefix": "L",
  "abstract_description": "电感",
  "value_spec": {
    "parameter": "inductance_h",
    "unit": "H"
  }
}
