{
  "schema_version": "1.0",
  "template_id": "common.passive.varistor",
  "version": "1.0.0",
  "status": "implemented",
  "family": "passive",
  "kind": "primitive",
  "description": "表达二端压敏元件及直流持续电压约束；不把它等同于恒定电阻或固定电压源。",
  "parameters_schema": {
    "type": "object",
    "properties": {
      "max_continuous_dc_voltage_v": {
        "type": "number",
        "description": "最大持续直流电压约束，V；本首版示例用于DC配置。",
        "exclusiveMinimum": 0
      },
      "varistor_voltage_v": {
        "type": [
          "number",
          "null"
        ],
        "description": "指定测试条件下的压敏电压，V；未知为null。",
        "exclusiveMinimum": 0
      },
      "test_current_a": {
        "type": [
          "number",
          "null"
        ],
        "description": "压敏电压对应的测试电流，A；未知为null。",
        "exclusiveMinimum": 0
      },
      "clamping_curve_ref": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "description": "钳位电压与测试波形/电流的依据；未知为null。"
      }
    },
    "required": [
      "max_continuous_dc_voltage_v",
      "varistor_voltage_v",
      "test_current_a",
      "clamping_curve_ref"
    ],
    "additionalProperties": false,
    "oneOf": [
      {
        "properties": {
          "varistor_voltage_v": {
            "type": "null"
          },
          "test_current_a": {
            "type": "null"
          }
        }
      },
      {
        "properties": {
          "varistor_voltage_v": {
            "type": "number"
          },
          "test_current_a": {
            "type": "number"
          }
        }
      }
    ]
  },
  "ports": [
    {
      "id": "a",
      "direction": "passive",
      "domain": "electrical",
      "width": 1
    },
    {
      "id": "b",
      "direction": "passive",
      "domain": "electrical",
      "width": 1
    }
  ],
  "body": {
    "representation": "terminal_contract",
    "description": "保留两个独立端点及器件实例；由显式pin_bindings建立角色和引脚的对应，不推断商品脚序或自动合并网络。"
  },
  "rules": [
    {
      "id": "paired_test_condition",
      "severity": "error",
      "description": "varistor_voltage_v 与 test_current_a 必须同时给出或同时为null，防止无条件的标称值。"
    },
    {
      "id": "distinct_voltage_meanings",
      "severity": "error",
      "description": "持续工作电压、测试条件下压敏电压、钳位电压不能互相替代。"
    },
    {
      "id": "surge_unresolved",
      "severity": "unresolved",
      "description": "无钳位曲线、浪涌波形与能量/电流依据时，浪涌保护有效性未确定。"
    }
  ],
  "sources": [
    {
      "kind": "design_contract",
      "reference": "00_Project-SPEC/netlist_design/NETLIST_GENERATION_DESIGN.md"
    }
  ],
  "example": {
    "parameters": {
      "max_continuous_dc_voltage_v": 30,
      "varistor_voltage_v": null,
      "test_current_a": null,
      "clamping_curve_ref": null
    },
    "pin_space": "logical",
    "pin_bindings": [
      {
        "port": "a",
        "bit": 0,
        "pin_id": "a"
      },
      {
        "port": "b",
        "bit": 0,
        "pin_id": "b"
      }
    ],
    "pins": [
      {
        "id": "a",
        "name": "a",
        "net": "N_SENSE"
      },
      {
        "id": "b",
        "name": "b",
        "net": "N_RETURN"
      }
    ],
    "expected": {
      "status": "logical_ready",
      "notes": "人工逻辑示例，仅连接信息就绪；可空性能参数仍为未知，未确认物理脚号或电气验证。"
    }
  },
  "device_type": "varistor",
  "designator_prefix": "RV",
  "abstract_description": "压敏电阻"
}
