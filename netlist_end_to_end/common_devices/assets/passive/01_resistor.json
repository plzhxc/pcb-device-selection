{
  "schema_version": "1.0",
  "template_id": "common.passive.resistor",
  "version": "1.0.0",
  "status": "implemented",
  "family": "passive",
  "kind": "primitive",
  "description": "单个无极性二端电阻的逻辑端子契约，保留电阻值与明确的网络连接；允许零欧姆，不查询商品数据库。",
  "parameters_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "resistance_ohm": {
        "type": "number",
        "minimum": 0,
        "description": "标称电阻，SI 单位 Ω，必填且不可 null；0 是有效的零欧姆值。"
      },
      "tolerance_ratio": {
        "type": [
          "number",
          "null"
        ],
        "description": "电阻相对容差，无量纲；例如 0.01 表示 1%。可省略或为 null，表示未提供，不能自动视为 0。",
        "minimum": 0,
        "maximum": 1
      },
      "rated_power_w": {
        "type": [
          "number",
          "null"
        ],
        "description": "额定功率，SI 单位 W；已知时严格大于 0，可省略或为 null。不依据封装猜测。",
        "exclusiveMinimum": 0
      }
    },
    "required": [
      "resistance_ohm"
    ],
    "additionalProperties": false
  },
  "ports": [
    {
      "id": "a",
      "direction": "passive",
      "domain": "electrical",
      "width": 1
    },
    {
      "id": "b",
      "direction": "passive",
      "domain": "electrical",
      "width": 1
    }
  ],
  "body": {
    "representation": "terminal_contract",
    "description": "a 与 b 是同一只电阻的两个逻辑端点。器件存在于两网络之间，并不令两网络自动合并；零欧姆器件也保留为独立实例。"
  },
  "rules": [
    {
      "id": "explicit_endpoint_binding",
      "severity": "error",
      "description": "每个逻辑端口的每一位必须恰好绑定一个示例引脚，每个引脚恰好被覆盖一次；端口名、引脚名、列表顺序均不替代显式绑定。"
    },
    {
      "id": "net_identity",
      "severity": "error",
      "description": "同一实例作用域中只有相同的非空网名表示相同网络；null 表示已知未连接，不与其他 null 自动互连。"
    },
    {
      "id": "physical_binding_missing",
      "severity": "unresolved",
      "description": "logical 示例仅证明逻辑连接已声明。需要物理导出时，必须提供全部实际引脚及来源，不得把 a、b 等逻辑 ID 当作真实脚号。"
    },
    {
      "id": "zero_ohm_preserved",
      "severity": "error",
      "description": "resistance_ohm 为 0 时仍保留器件、两引脚和两侧网名，不执行短接删除或网络收缩。"
    },
    {
      "id": "terminal_same_net",
      "severity": "warning",
      "description": "若 a、b 绑定到同一个非空网名，保留原连接并提示两端处于同网，不自动修正。"
    },
    {
      "id": "power_check_not_covered",
      "severity": "unresolved",
      "description": "若任务要求功耗校核而缺少额定功率或电路工作条件，则该校核未就绪；不影响已明确的逻辑端子连接。"
    }
  ],
  "sources": [
    {
      "kind": "design_contract",
      "reference": "00_Project-SPEC/netlist_design/NETLIST_GENERATION_DESIGN.md"
    }
  ],
  "example": {
    "parameters": {
      "resistance_ohm": 10000,
      "tolerance_ratio": null,
      "rated_power_w": null
    },
    "pin_space": "logical",
    "pin_bindings": [
      {
        "port": "a",
        "bit": 0,
        "pin_id": "a"
      },
      {
        "port": "b",
        "bit": 0,
        "pin_id": "b"
      }
    ],
    "pins": [
      {
        "id": "a",
        "name": "a",
        "net": "CTRL"
      },
      {
        "id": "b",
        "name": "b",
        "net": "BIAS"
      }
    ],
    "expected": {
      "status": "logical_ready",
      "notes": "人为示例的 10000 Ω 不表示推荐阻值。两端连接已明确；容差、功率校核和实物脚号尚未提供。"
    }
  },
  "device_type": "resistor",
  "designator_prefix": "R",
  "abstract_description": "电阻",
  "value_spec": {
    "parameter": "resistance_ohm",
    "unit": "Ω"
  }
}
