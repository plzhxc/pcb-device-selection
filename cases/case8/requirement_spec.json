          "source_parameter": "output_voltage"
        },
        {
          "field": "efficiency",
          "op": ">=",
          "value": 85.0,
          "unit": "%",
          "reason": "硬件需求说明书 3.1.1 节明确规定电源效率 ≥ 85%。这是为了控制功耗和发热，特别是在 28V 输入降至 5V 的大压差工况下，低效率会导致严重的热损耗。",
          "source_parameter": "efficiency"
        },
        {
          "field": "operating_temperature",
          "op": "cover",
          "value": [
            -40.0,
            85.0
          ],
          "unit": "°C",
