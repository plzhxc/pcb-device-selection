    {
      "id": "M-PWR-XL4016-001",
      "module_name": "XL4016E1 DC-DC降压模块",
      "module_type": "电源芯片",
      "category": "电源管理 IC",
      "leaf_code": "l_step_down_dc_dc_converter",
      "quantity": 1,
      "related_requirements": [],
      "hard_conditions": [
        {
          "field": "input_voltage_range",
          "op": "cover",
          "value": [
            4.0,
            40.0
          ],
          "unit": "V",
          "reason": "需求文档明确要求 DC Jack 输入支持 9V-40V，且 Type-C PD 可能提供最低 5V（甚至部分协议下更低）。XL4016E1 数据手册标称输入上限通常为 40V。若输入超过 40V 将导致器件击穿损坏。同时需兼容低电压 PD 输入，故下限设为 4V 以覆盖典型 Buck 启动阈值。",
          "source_parameter": "input_voltage_range"
        },
        {
          "field": "output_voltage_range",
          "op": "cover",
          "value": [
            1.2,
            36.0
          ],
          "unit": "V",
          "reason": "需求要求输出 Motor Rail 建议 <15V 以兼容 LDO。然而，Buck 转换器本身需要具备足够的升压/降压能力。考虑到输入最高 40V，若使用同步整流 Buck，输出电压通常远低于输入。对于异步或非同步架构（如 XL4016），输出电压受限于输入和占空比。关键约束是器件必须能稳定输出用户所需的低压（如 5V, 9V, 12V）。上限 36V 是为了确保器件规格书的一般性覆盖，实际应用中",
          "source_parameter": "output_voltage_range"
        },
        {
          "field": "ripple_noise",
          "op": ">=",
          "value": 50.0,
          "unit": "mVpp",
          "reason": "需求文档明确规定纹波噪声需控制在 50 mV pp 以内，以避免干扰 IMU 模拟信号及 ADC 采样精度。这对于高精度传感器（IMU）和数字逻辑供电都是关键指标。若纹波过大，可能导致电机控制不稳定或传感器数据错误。",
          "source_parameter": "ripple_noise"
        },
        {
          "field": "operating_temperature",
          "op": "cover",
          "value": [
            -40.0,
            85.0
          ],
          "unit": "°C",
          "reason": "硬件需求说明书 4.1.2 节指出元器件需为工业级 (-40℃ ~ +85℃)，且系统工作温度为 -10°C ~ 50°C。为确保在高温环境（如密闭小车内部、夏季户外）下 8A 电流输出的可靠性，器件必须具备足够的温度余量。",
          "source_parameter": "operating_temperature"
        }
      ],
      "preferred_conditions": [
        {
          "field": "switching_frequency",
          "op": ">=",
          "value": 400000.0,
          "unit": "Hz",
          "reason": "XL4016E1 的典型开关频率为 400kHz。该频率决定了外部电感、电容的选型大小以及 EMI 特性。虽然存在一定工程折中空间（如改用 300kHz-500kHz 的其他芯片），但为了匹配已指定的 XL4016E1 外围元件设计或保持效率/体积平衡，应锁定此频率。",
          "source_parameter": "switching_frequency"
        },
        {
          "field": "efficiency",
          "op": ">=",
          "value": 88.0,
          "unit": "%",
          "reason": "需求文档指定电源效率为 88%。高效率意味着更少的热损耗，对于 8A 大电流应用至关重要，直接影响散热设计和可靠性。虽然可以通过优化外围元件和 PCB 布局提升效率，但器件本身的拓扑（同步 vs 异步）和内阻是基础。XL4016 通常为非同步（异步）整流，效率略低于同步整流方案，因此需明确此参数为对器件及其外围系统的综合性能要求。",
          "source_parameter": "efficiency"
        }
      ],
      "keywords": [
